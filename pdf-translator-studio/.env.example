# Copy to .env. Restart the server after changes. Node.js 24.5+.
PORT=4173

# Intranet / Ollama / LM Studio / vLLM: OpenAI-compatible base URL.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
# Local connections bypass the corporate proxy by default.
# App-saved proxy settings override this flag unless environment mode is selected.
LOCAL_LLM_USE_PROXY=false
# auto: request JSON Schema; fall back only if the server explicitly rejects it.
# Other choices: json_schema, json_object, prompt.
LOCAL_LLM_JSON_MODE=auto

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
# auto: GPT-4 family -> chat, GPT-5+ / o-series -> responses.
OPENAI_API_MODE=auto
# Blank uses the model default; valid efforts depend on the chosen model.
OPENAI_REASONING_EFFORT=
OPENAI_MAX_OUTPUT_TOKENS=16384
LOCAL_LLM_MAX_TOKENS=8192
# Optional legacy default only, used until translation settings are saved in the app.
# Blank: local LLM 600 seconds; OpenAI 180 seconds. Configure each in Connection settings.
# Valid legacy values: 1000..1800000 ms; app settings round/clamp to 30..1800 seconds.
REQUEST_TIMEOUT_MS=

# Optional legacy settings: proxy can instead be saved in the app Connection dialog.
# App custom/direct mode overrides these; environment mode preserves them.
# Forward proxy; HTTP CONNECT is used for HTTPS destinations.
# Example: http://proxy.company.example:8080
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,.internal
# Optional Basic proxy authentication (or URL-encoded user:password in proxy URL).
PROXY_USERNAME=
PROXY_PASSWORD=
# Corporate CA PEM. Use node launch.mjs so the CA is inherited before Node startup.
# NODE_EXTRA_CA_CERTS=C:/certificates/company-ca.pem
