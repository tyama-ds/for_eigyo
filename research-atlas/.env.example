# Optional server settings only. Never commit credentials.
# LLM API keys, local LLM settings and proxy settings belong in the browser:
# Analysis settings -> LLM/API / Proxy connection settings.
# LLM and proxy environment variables are not used for these connections.
# The app never writes .env.

# Legacy embedding=transformer API only (first use downloads weights).
# The GUI's explicit SBERT presets do not use this override.
# ATLAS_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional local data location; defaults to ./data
# ATLAS_DATA_DIR=

# Optional Scopus retrieval for iterative exploration. Public sources work without this.
# API access and abstract availability depend on your Elsevier subscription/entitlements.
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=
# Alias accepted if ELSEVIER_API_KEY is empty: SCOPUS_API_KEY=

# Optional Japanese TrueType font for PDF export (Meiryo on Windows is auto-detected).
# ATLAS_PDF_FONT=
